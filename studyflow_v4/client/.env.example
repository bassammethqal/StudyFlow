# StudyFlow Client - Environment Variables Configuration

# API URL for hosted backend
# Required ONLY when the frontend is hosted separately from the backend (e.g. Vercel, Netlify, Cloudflare Pages).
# Accepts either the base backend domain or the /api endpoint:
# VITE_API_URL=https://studyflow-api.onrender.com
# or
# VITE_API_URL=https://studyflow-api.onrender.com/api

# For local development with Vite dev server (port 5173) or when served directly from Express (client/dist),
# leave VITE_API_URL blank to automatically use relative /api proxy:
VITE_API_URL=
