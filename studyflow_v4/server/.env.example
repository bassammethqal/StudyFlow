# ==============================================================================
# StudyFlow Server - Production & Development Environment Template
# ==============================================================================

# Application Environment ('production' or 'development')
NODE_ENV=production

# Server Port
PORT=4000

# JSON Web Token Secret
# MANDATORY IN PRODUCTION: Must be at least 16 characters (recommended 32+ random characters).
# Server will refuse to start in production if missing, default, or under 16 characters.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# Allowed CORS Origins (Comma-separated for multiple hosted frontends)
# Example: https://studyflow-app.vercel.app,https://studyflow.myuni.edu
# Set to * or leave empty in local development to allow any origin.
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Frontend Web Application URL (used in password reset emails)
CLIENT_URL=https://your-frontend-domain.vercel.app
CLIENT_ORIGIN=https://your-frontend-domain.vercel.app

# Reverse Proxy Trust (1 for Render, Railway, Fly.io, Heroku, Nginx)
# Enables accurate IP resolution for rate limiting behind reverse proxies.
TRUST_PROXY=1

# Neon PostgreSQL Database Connection String
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# If left empty, StudyFlow falls back to local SQLite (studyflow.db) for local development.
DATABASE_URL=

# Email SMTP Settings (For Real Password Reset Emails)
# If omitted in development, verification codes are logged to console and returned to client.
# In production, SMTP should be configured to ensure real email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StudyFlow <no-reply@studyflow.local>"
