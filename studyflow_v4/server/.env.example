PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# إعدادات البريد الإلكتروني (اختياري لإرسال الرسائل الحقيقية عبر SMTP مثل Gmail أو Outlook)
# في حال تركها فارغة، سيتم محاكاة الإرسال وطباعة رمز التحقق في الـ Terminal وشاشة التطبيق لتسهيل التجربة
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StudyFlow <no-reply@studyflow.local>"
